[node name="Paragraph1" type="RichTextLabel" parent="." unique_id=2038339028]
layout_mode = 0
offset_left = 64.0
offset_top = 72.0
offset_right = 1600.0
offset_bottom = 244.0555
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_constants/line_separation = 3
theme_override_constants/outline_size = 4
theme_override_fonts/normal_font = ExtResource("3_srs8t")
theme_override_font_sizes/normal_font_size = 60
text = "As far as Juliette was concerned, the sparrows of the junkyard were her family."

[node name="Paragraph2" type="RichTextLabel" parent="." unique_id=1067367462]
layout_mode = 0
offset_left = 64.0
offset_top = 258.00024
offset_right = 1384.0
offset_bottom = 1122.441
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_constants/line_separation = 3
theme_override_fonts/normal_font = ExtResource("3_srs8t")
theme_override_font_sizes/normal_font_size = 50
text = "Her earliest memory is of being ushered into a broken TV while an eagle scoured overhead, huddling in fear with these little birds who had decided to help her. They'd introduced her to the junkyard's management: an ancient one-eyed raccoon who handled all trade between scavengers, who she
 had been too scared to approach all by herself. They taught her to recognise the sounds of the trucks that brought the tastiest food, and which ones might unload the most interesting treasures. "

[node name="Paragraph3" type="RichTextLabel" parent="." unique_id=348873409]
layout_mode = 0
offset_left = 64.0
offset_top = 864.0
offset_right = 1480.0
offset_bottom = 1248.0
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_constants/line_separation = 3
theme_override_fonts/normal_font = ExtResource("3_srs8t")
theme_override_font_sizes/normal_font_size = 50
text = "The one lesson she couldn't seem to learn was how to fly. She understood the mechanics and technique, but she seemed to lack some very important anatomy. Her family loved her with or without wings, but she
was growing tired of pretending that she wasn't
missing out...."

