theme_override_constants/line_separation = 3
theme_override_fonts/normal_font = ExtResource("3_50ba6")
theme_override_font_sizes/normal_font_size = 50
text = "Last migration she had tried to see the joy in having some alone time to tinker with her inventions uninterrupted... but the winter was cold and lonely...."

