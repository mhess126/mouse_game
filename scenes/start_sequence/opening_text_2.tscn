theme_override_constants/line_separation = 3
theme_override_fonts/normal_font = ExtResource("3_50ba6")
theme_override_font_sizes/normal_font_size = 50
text = "					 	 For four months she had to fend for herself in
						 the junkyard and patiently wait for her family to return. They spoke of the beautiful sights down south: junkyards right on the shore of the ocean, landfills up in beautiful hills, some with the most interesting treasures her eyes lit up hearing the stories."

[node name="Paragraph3" type="RichTextLabel" parent="." unique_id=348873409]
layout_mode = 0
